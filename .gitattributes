# The tokenizer's SHA-256 is recorded in every prepared dataset (meta.json) and checkpoint, and
# checked whenever they are loaded. Git's CRLF conversion on Windows (core.autocrlf=true) would
# change the bytes and so the hash, making shards and checkpoints unusable across machines.
data/tokenizer/** text eol=lf
# Shell scripts run on Linux pods (scripts/runpod/): a CRLF checkout would break them ("$'\r': command not found").
*.sh text eol=lf
